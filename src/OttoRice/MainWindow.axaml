<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:OttoRice"
        xmlns:backup="using:OttoRice.Features.BackupRestore"
        xmlns:install="using:OttoRice.Features.ThemeInstall"
        xmlns:toggle="using:OttoRice.Features.ThemeToggle"
        xmlns:editor="using:OttoRice.Features.ThemeEditor.Models"
        xmlns:conv="using:OttoRice.Converters"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="680"
        x:Class="OttoRice.MainWindow"
        x:DataType="local:MainViewModel"
        Icon="/Assets/ottorice.ico"
        Title="OttoRice"
        Width="1000" Height="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDeepBrush}">

    <Grid RowDefinitions="56,*,28">

        <!-- ── Cabeçalho ─────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource BgPrimaryBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <TextBlock Text="◧" Foreground="{DynamicResource AccentBrush}" FontSize="18" VerticalAlignment="Center" />
                <TextBlock Text="OTTO" Classes="h1" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="RICE" Classes="h1" Foreground="{DynamicResource GoldBrush}" VerticalAlignment="Center" />
                <TextBlock Text="temas de desktop para windows" Classes="muted" Margin="16,4,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent">

            <!-- ══ Instalar tema ══════════════════════════════════════════ -->
            <TabItem Header="INSTALAR TEMA">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="20,16" DataContext="{Binding Install}">

                    <StackPanel Grid.Row="0" Spacing="8">
                        <TextBlock Text="REPOSITÓRIO DO TEMA" Classes="eyebrow" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{Binding ThemeUrl}"
                                     Watermark="URL do GitHub, pasta local ou rice-manifest.json"
                                     Width="520"
                                     IsEnabled="{Binding !IsBusy}" />
                            <Button Content="BUSCAR" Classes="btn-secondary" Command="{Binding FetchCommand}" />
                            <Button Content="ARQUIVO..." Classes="btn-secondary" Command="{Binding BrowseCommand}"
                                    ToolTip.Tip="Selecionar um rice-manifest.json no disco" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Preview / consentimento informado (RF-03) -->
                    <Border Grid.Row="1" Classes="card" Margin="0,16,0,0" IsVisible="{Binding HasPreview}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="10">
                                <TextBlock Text="{Binding ThemeTitle}" Classes="h2" TextWrapping="Wrap" />
                                <StackPanel Spacing="3">
                                    <TextBlock Text="APPS QUE SERÃO ALTERADOS" Classes="eyebrow" />
                                    <ItemsControl ItemsSource="{Binding AffectedApps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat='› {0}'}" Classes="dim" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="DEPENDÊNCIAS (WINGET)" Classes="eyebrow" />
                                    <ItemsControl ItemsSource="{Binding Dependencies}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat='› {0}'}" Classes="dim" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Column="1" Margin="16,0,0,0"
                                    BorderBrush="{DynamicResource BorderBrightBrush}" BorderThickness="1"
                                    CornerRadius="3" Padding="1">
                                <Image Source="{Binding PreviewImage}" MaxWidth="260" MaxHeight="150" Stretch="Uniform" />
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                        <Button Content="INSTALAR TEMA" Classes="btn-primary" Command="{Binding InstallCommand}" />
                        <Button Content="CANCELAR" Classes="btn-secondary" Command="{Binding CancelCommand}" />
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                                     Width="180" Height="4" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Visualização gráfica das etapas do pipeline (além do log escrito abaixo) -->
                    <Border Grid.Row="3" Classes="card" Margin="0,16,0,0" IsVisible="{Binding HasPreview}">
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="install:StepStatusItem">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <StackPanel Spacing="6" Width="112" HorizontalAlignment="Center">
                                            <Border Width="26" Height="26" CornerRadius="13"
                                                    HorizontalAlignment="Center"
                                                    Background="{DynamicResource BgSecondaryBrush}"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{Binding State, Converter={x:Static conv:InstallStepStateToBrushConverter.Instance}}">
                                                <TextBlock Text="{Binding State, Converter={x:Static conv:InstallStepStateToGlyphConverter.Instance}}"
                                                           Foreground="{Binding State, Converter={x:Static conv:InstallStepStateToBrushConverter.Instance}}"
                                                           FontSize="13" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Classes="muted" TextWrapping="Wrap"
                                                       TextAlignment="Center" />
                                        </StackPanel>
                                        <Border Width="20" Height="1.5" VerticalAlignment="Center" Margin="0,0,0,20"
                                                Background="{DynamicResource BorderBrush2}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border Grid.Row="4" Classes="console" Margin="0,16,0,0">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Log}" Margin="12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Classes="mono-log" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══ Tema ativo ═════════════════════════════════════════════ -->
            <TabItem Header="TEMA ATIVO">
                <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="20,16" DataContext="{Binding Control}">

                    <Border Grid.Row="0" Classes="card">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="TEMA APLICADO" Classes="eyebrow" />
                                <TextBlock Text="{Binding ThemeTitle}" Classes="h2" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="{Binding StateLabel}" Classes="dim" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                        <Button Content="LIGAR TEMA" Classes="btn-primary" Command="{Binding TurnOnCommand}" />
                        <Button Content="DESLIGAR TEMA" Classes="btn-secondary" Command="{Binding TurnOffCommand}" />
                        <Button Content="PAUSAR/RETOMAR TILING" Classes="btn-secondary" Command="{Binding TogglePauseCommand}" />
                        <Button Content="REAPLICAR TEMA" Classes="btn-secondary" Command="{Binding ReapplyCommand}"
                                ToolTip.Tip="Baixa os arquivos do tema novamente e os reaplica (config/wallpaper/reload)." />
                        <Button Content="ATUALIZAR" Classes="btn-secondary" Command="{Binding RefreshCommand}" />
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                                     Width="140" Height="4" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Grid.Row="2" Classes="card" Margin="0,16,0,0" IsVisible="{Binding HasActiveTheme}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="DESINSTALAR ESTE TEMA" Classes="eyebrow" />
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="As configurações anteriores são restauradas do backup. As ferramentas abaixo só são removidas se você marcar — e apenas quando nenhum outro tema instalado depende delas." />
                            <ItemsControl ItemsSource="{Binding RemovableTools}" Margin="0,2,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding RemoveIt}"
                                                  IsEnabled="{Binding CanRemove}"
                                                  Content="{Binding Description}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="DESINSTALAR TEMA" Classes="btn-gold"
                                    HorizontalAlignment="Left" Command="{Binding UninstallCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Classes="console" Margin="0,16,0,0">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Log}" Margin="12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Classes="mono-log" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══ Temas instalados ═══════════════════════════════════════ -->
            <TabItem Header="TEMAS INSTALADOS">
                <Grid x:Name="InstalledThemesRoot" RowDefinitions="Auto,Auto,*" Margin="20,16" DataContext="{Binding InstalledThemes}">

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="TODOS OS TEMAS INSTALADOS" Classes="eyebrow" VerticalAlignment="Center" />
                        <Button Content="ATUALIZAR" Classes="btn-secondary" Command="{Binding RefreshCommand}" />
                        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"
                                     Width="140" Height="4" VerticalAlignment="Center" />
                    </StackPanel>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Themes}" Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="toggle:InstalledThemeItem">
                                <Border Classes="card" Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding ThemeName}" Classes="h2" />
                                                <TextBlock Text="{Binding StatusLabel}" Classes="dim" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Classes="muted"
                                                       Text="{Binding InstalledAt, StringFormat='instalado em {0:dd/MM/yyyy HH:mm}'}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Button Content="ATIVAR" Classes="btn-primary"
                                                    IsEnabled="{Binding !IsActive}"
                                                    Command="{Binding #InstalledThemesRoot.DataContext.ActivateCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="REAPLICAR" Classes="btn-secondary"
                                                    Command="{Binding #InstalledThemesRoot.DataContext.ReapplyCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="DESINSTALAR" Classes="btn-gold"
                                                    Command="{Binding #InstalledThemesRoot.DataContext.UninstallCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>

            <!-- ══ Backups ════════════════════════════════════════════════ -->
            <TabItem Header="BACKUPS">
                <Grid RowDefinitions="Auto,*" Margin="20,16" DataContext="{Binding Backups}">
                    <StackPanel Grid.Row="0" Spacing="8">
                        <TextBlock Text="SESSÕES DE BACKUP" Classes="eyebrow" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="ATUALIZAR" Classes="btn-secondary" Command="{Binding RefreshCommand}" />
                            <Button Content="RESTAURAR SELECIONADO" Classes="btn-primary" Command="{Binding RestoreCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" Classes="console" Margin="0,16,0,0">
                        <ListBox ItemsSource="{Binding Sessions}"
                                 SelectedItem="{Binding SelectedSession}"
                                 Background="Transparent" Margin="6">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="backup:BackupSessionInfo">
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Classes="dim" />
                                        <TextBlock Text="{Binding ThemeId}" FontWeight="Bold" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>
            <!-- ══ Editor de manifesto ═══════════════════════════════════════ -->
            <TabItem Header="EDITAR MANIFESTO">
                <Grid x:Name="EditorRoot" RowDefinitions="Auto,*" Margin="20,16" DataContext="{Binding Editor}">

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <Button Content="ABRIR..." Classes="btn-secondary" Command="{Binding BrowseCommand}"
                                ToolTip.Tip="Selecionar um rice-manifest.json ou a pasta de um tema local" />
                        <Button Content="SALVAR" Classes="btn-primary" Command="{Binding SaveCommand}" />
                        <TextBlock Text="{Binding ManifestPath}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
                        <StackPanel Spacing="16" IsEnabled="{Binding IsLoaded}">

                            <!-- Campos de topo -->
                            <Border Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="METADADOS DO TEMA" Classes="eyebrow" />
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="themeId" Classes="dim" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ThemeId}" Watermark="ex.: blackturq-minimal" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="name" Classes="dim" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name}" Watermark="Nome exibido do tema" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="author" Classes="dim" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Author}" Watermark="(opcional)" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="preview" Classes="dim" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Preview}" Watermark="caminho relativo, ex.: assets/preview.png" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Dependencies -->
                            <Border Classes="card">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="DEPENDÊNCIAS (WINGET)" Classes="eyebrow" VerticalAlignment="Center" />
                                        <Button Content="+ ADICIONAR" Classes="btn-secondary" Command="{Binding AddDependencyCommand}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Dependencies}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="editor:EditableDependency">
                                                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Margin="0,2">
                                                    <TextBox Grid.Column="0" Text="{Binding WingetId}" Watermark="wingetId" />
                                                    <TextBox Grid.Column="1" Text="{Binding MinVersion}" Watermark="minVersion (opcional)" />
                                                    <Button Grid.Column="2" Content="✕" Classes="btn-secondary"
                                                            Command="{Binding #EditorRoot.DataContext.RemoveDependencyCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Targets -->
                            <Border Classes="card">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="TARGETS" Classes="eyebrow" VerticalAlignment="Center" />
                                        <Button Content="+ ADICIONAR" Classes="btn-secondary" Command="{Binding AddTargetCommand}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Targets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="editor:EditableTarget">
                                                <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1"
                                                        Padding="0,8" Margin="0,2">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnDefinitions="*,*,2*,Auto" ColumnSpacing="8">
                                                            <ComboBox Grid.Column="0"
                                                                      ItemsSource="{Binding #EditorRoot.DataContext.AvailableApps}"
                                                                      SelectedItem="{Binding App}"
                                                                      PlaceholderText="app" HorizontalAlignment="Stretch" />
                                                            <ComboBox Grid.Column="1"
                                                                      ItemsSource="{Binding AllowedActions}"
                                                                      SelectedItem="{Binding Action}"
                                                                      PlaceholderText="action" HorizontalAlignment="Stretch" />
                                                            <TextBox Grid.Column="2" Text="{Binding Source}"
                                                                     Watermark="source (caminho relativo ao tema)" />
                                                            <Button Grid.Column="3" Content="✕" Classes="btn-secondary"
                                                                    Command="{Binding #EditorRoot.DataContext.RemoveTargetCommand}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>

                                                        <CheckBox Content="setAsDefault (Windows Terminal)"
                                                                  IsChecked="{Binding SetAsDefault}"
                                                                  IsVisible="{Binding IsWindowsTerminal}" />

                                                        <StackPanel IsVisible="{Binding IsConfigureMod}" Spacing="4" Margin="0,4,0,0">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="settings (mod Windhawk)" Classes="dim" VerticalAlignment="Center" />
                                                                <Button Content="+ SETTING" Classes="btn-secondary"
                                                                        Command="{Binding #EditorRoot.DataContext.AddSettingCommand}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                            <ItemsControl ItemsSource="{Binding Settings}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="editor:EditableSetting">
                                                                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Margin="0,2">
                                                                            <TextBox Grid.Column="0" Text="{Binding Key}" Watermark="chave" />
                                                                            <TextBox Grid.Column="1" Text="{Binding Value}" Watermark="valor" />
                                                                            <Button Grid.Column="2" Content="✕" Classes="btn-secondary"
                                                                                    Command="{Binding #EditorRoot.DataContext.RemoveSettingCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Erros de validação -->
                            <Border Classes="card" IsVisible="{Binding HasValidationErrors}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="ERROS DE VALIDAÇÃO" Classes="eyebrow" Foreground="{DynamicResource GoldBrush}" />
                                    <ItemsControl ItemsSource="{Binding ValidationErrors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat='› {0}'}" Classes="dim" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ── Barra de status ───────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{DynamicResource BgPrimaryBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" Classes="muted" VerticalAlignment="Center" Margin="12,0" />
        </Border>
    </Grid>
</Window>
