<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:OttoRice"
        xmlns:backup="using:OttoRice.Features.BackupRestore"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="560"
        x:Class="OttoRice.MainWindow"
        x:DataType="local:MainViewModel"
        Title="OttoRice"
        Width="720" Height="560"
        WindowStartupLocation="CenterScreen">

    <TabControl Margin="8">

        <TabItem Header="Instalar tema">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="12" DataContext="{Binding Install}">

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding ThemeUrl}"
                             Watermark="https://github.com/owner/repo (com rice-manifest.json)"
                             Width="480"
                             IsEnabled="{Binding !IsBusy}"/>
                    <Button Content="Buscar" Command="{Binding FetchCommand}"/>
                </StackPanel>

                <!-- Preview / consentimento informado (RF-03) -->
                <Border Grid.Row="1" Margin="0,12,0,0" Padding="12"
                        CornerRadius="6" BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        IsVisible="{Binding HasPreview}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{Binding ThemeTitle}"
                                   FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Spacing="4">
                            <TextBlock Text="Apps que serão alterados:" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{Binding AffectedApps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Dependências (WinGet):" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            <ItemsControl ItemsSource="{Binding Dependencies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Image Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                               Source="{Binding PreviewImage}"
                               MaxWidth="220" MaxHeight="140" Margin="12,0,0,0"
                               Stretch="Uniform"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                    <Button Content="Instalar tema"
                            Command="{Binding InstallCommand}"
                            Classes="accent"/>
                    <Button Content="Cancelar" Command="{Binding CancelCommand}"/>
                </StackPanel>

                <!-- Log de progresso do pipeline -->
                <Border Grid.Row="3" Margin="0,12,0,0" CornerRadius="6" BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Log}" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Cascadia Mono,Consolas,monospace"
                                               FontSize="12" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="4" Margin="0,10,0,0" Spacing="6">
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4"/>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Tema ativo">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="12" DataContext="{Binding Control}">

                <StackPanel Grid.Row="0" Spacing="4">
                    <TextBlock Text="{Binding ThemeTitle}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StateLabel}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                    <Button Content="Ligar tema" Command="{Binding TurnOnCommand}" Classes="accent"/>
                    <Button Content="Desligar tema" Command="{Binding TurnOffCommand}"/>
                    <Button Content="Pausar/retomar tiling" Command="{Binding TogglePauseCommand}"/>
                    <Button Content="Atualizar" Command="{Binding RefreshCommand}"/>
                </StackPanel>

                <Border Grid.Row="2" Margin="0,16,0,0" Padding="12" CornerRadius="6" BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        IsVisible="{Binding HasActiveTheme}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Desinstalar este tema" FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Text="As configurações anteriores são restauradas do backup. As ferramentas abaixo só são removidas se você marcar — e apenas quando nenhum outro tema instalado depende delas."/>
                        <ItemsControl ItemsSource="{Binding RemovableTools}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding RemoveIt}"
                                              IsEnabled="{Binding CanRemove}"
                                              Content="{Binding Description}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Desinstalar tema" Command="{Binding UninstallCommand}"
                                HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Margin="0,12,0,0" CornerRadius="6" BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Log}" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Cascadia Mono,Consolas,monospace"
                                               FontSize="12" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="4" Margin="0,10,0,0" Spacing="6">
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4"/>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Backups">
            <Grid RowDefinitions="Auto,*,Auto" Margin="12" DataContext="{Binding Backups}">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <Button Content="Atualizar" Command="{Binding RefreshCommand}"/>
                    <Button Content="Restaurar selecionado" Command="{Binding RestoreCommand}"/>
                </StackPanel>

                <ListBox Grid.Row="1" Margin="0,12,0,0"
                         ItemsSource="{Binding Sessions}"
                         SelectedItem="{Binding SelectedSession}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="backup:BackupSessionInfo">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"/>
                                <TextBlock Text="{Binding ThemeId}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2" Margin="0,10,0,0"
                           Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
            </Grid>
        </TabItem>

    </TabControl>
</Window>
