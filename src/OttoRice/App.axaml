<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
             x:Class="OttoRice.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <themes:MaterialTheme BaseTheme="Dark" PrimaryColor="Red" SecondaryColor="Amber" />
        <StyleInclude Source="avares://OttoRice/Styles/OttoTheme.axaml" />
    </Application.Styles>
</Application>
