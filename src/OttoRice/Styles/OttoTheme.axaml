<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ── Paleta da família Otto (mesma do OttoInfra, derivada do ottosite) ──
       Mantida idêntica de propósito: os apps desktop devem parecer irmãos. -->
  <Styles.Resources>
    <Color x:Key="BgDeepColor">#060003</Color>
    <Color x:Key="BgPrimaryColor">#090004</Color>
    <Color x:Key="BgSecondaryColor">#0D0006</Color>
    <Color x:Key="BgCardColor">#130008</Color>
    <Color x:Key="BgCardHoverColor">#1A000C</Color>
    <Color x:Key="BorderColor">#2A0410</Color>
    <Color x:Key="BorderBrightColor">#4A0820</Color>
    <Color x:Key="BorderGlowColor">#7A1035</Color>
    <Color x:Key="TextPrimaryColor">#F5B0C0</Color>
    <Color x:Key="TextSecondaryColor">#8A3850</Color>
    <Color x:Key="TextTertiaryColor">#5A1830</Color>
    <Color x:Key="AccentColor">#FF1F3D</Color>
    <Color x:Key="AccentDimColor">#CC1530</Color>
    <Color x:Key="GoldColor">#FFB000</Color>
    <Color x:Key="GoldDimColor">#CC8800</Color>
    <Color x:Key="SuccessColor">#3ECF8E</Color>

    <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeepColor}" />
    <SolidColorBrush x:Key="BgPrimaryBrush" Color="{StaticResource BgPrimaryColor}" />
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource BgCardHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderBrightBrush" Color="{StaticResource BorderBrightColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}" />
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="GoldDimBrush" Color="{StaticResource GoldDimColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

    <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas,Courier New,monospace</FontFamily>
  </Styles.Resources>

  <!-- ── Base ───────────────────────────────────────────────────────────── -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource BgDeepBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="LetterSpacing" Value="2" />
    <Setter Property="Foreground" Value="{StaticResource AccentDimBrush}" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style Selector="TextBlock.mono-log">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>

  <!-- ── Cards / painéis ────────────────────────────────────────────────── -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <Style Selector="Border.console">
    <Setter Property="Background" Value="{StaticResource BgSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <!-- ── Botões estilo ottosite (retos, uppercase, letter-spaced) ─────────── -->
  <Style Selector="Button.btn-primary">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentDimBrush}" />
  </Style>

  <Style Selector="Button.btn-secondary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrightBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.btn-secondary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BgCardHoverBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>

  <Style Selector="Button.btn-gold">
    <Setter Property="Background" Value="{StaticResource GoldBrush}" />
    <Setter Property="Foreground" Value="#1A0A00" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource GoldBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.btn-gold:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource GoldDimBrush}" />
  </Style>

  <!-- ── Badges de status ──────────────────────────────────────────────── -->
  <Style Selector="Border.status-active">
    <Setter Property="Background" Value="#1AFF1F3D" />
    <Setter Property="BorderBrush" Value="#59FF1F3D" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="Border.status-inactive">
    <Setter Property="Background" Value="#19646464" />
    <Setter Property="BorderBrush" Value="#4D646464" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="8,3" />
  </Style>

  <!-- ── Campos de entrada ─────────────────────────────────────────────── -->
  <Style Selector="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrightBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource AccentDimBrush}" />
  </Style>
  <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="Background" Value="{StaticResource BorderColor}" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BgCardHoverBrush}" />
  </Style>

  <!-- ── Scrollbars: thumb no accent para não sumir contra o fundo escuro ── -->
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{StaticResource BorderBrightBrush}" />
    <Setter Property="MinWidth" Value="8" />
    <Setter Property="MinHeight" Value="8" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb:pointerover">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="ScrollBar /template/ RepeatButton">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ── TabControl ─────────────────────────────────────────────────────── -->
  <Style Selector="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TabItem">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
  </Style>
  <Style Selector="TabItem:pointerover /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

</Styles>
