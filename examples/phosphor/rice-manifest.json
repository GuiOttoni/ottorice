{
  "schemaVersion": "1.0",
  "themeId": "phosphor",
  "name": "Phosphor",
  "author": "ottorice",
  "preview": "assets/preview.png",
  "dependencies": [
    { "wingetId": "glzr-io.glazewm", "minVersion": "3.0.0" },
    { "wingetId": "AmN.yasb" }
  ],
  "targets": [
    {
      "app": "glazewm",
      "action": "override",
      "source": "configs/glazewm/config.yaml"
    },
    {
      "app": "yasb",
      "action": "override",
      "source": "configs/yasb"
    },
    {
      "app": "windows_terminal",
      "action": "merge_scheme",
      "source": "configs/wt-scheme.json",
      "setAsDefault": true
    },
    {
      "app": "wallpaper",
      "action": "set",
      "source": "assets/wallpaper.png"
    }
  ]
}
